DATABASE_URL="postgresql://openheart:openheart@localhost:5432/openheart?schema=public"
# Only if DATABASE_URL goes through a transaction-mode pooler (PgBouncer): the
# direct URL, used for live updates (LISTEN/NOTIFY).
REALTIME_DATABASE_URL=""

# Auth.js reads AUTH_SECRET first, then NEXTAUTH_SECRET. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public address used in email links (defaults to AUTH_URL)
APP_URL="http://localhost:3000"

# Email (Resend, free tier). Without these, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="OpenHeart <hello@example.com>"

# Bot check on sign-up, login, and password reset (Cloudflare Turnstile, free). Optional.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Error alerts (Sentry, free tier). Optional; no member data is ever sent.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

CLOUDFLARE_API_TOKEN=""
DIGITALOCEAN_ACCESS_TOKEN=""

# Public safety / child-safety contact (required by the App Store and Google Play)
SUPPORT_EMAIL=""

# Keys the hashes behind permanent bans. Set once and never change it, or
# existing bans stop matching. Falls back to AUTH_SECRET when empty.
BAN_HASH_SECRET=""

# Age verification. Set up one provider (didit, persona or veriff); members go
# through its hosted flow, the signed result arrives at
# /api/verification/<provider>-webhook, and the provider is then told to delete
# the ID images and personal data. VERIFICATION_PROVIDER picks one when several
# have keys. Without any, a dev stub is used (disabled in production unless
# ALLOW_VERIFICATION_STUB=true).
VERIFICATION_PROVIDER=""

# Didit: 500 free checks a month. Workflow must include ID verification so the
# birthdate comes back. Webhook: /api/verification/didit-webhook (status.updated).
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""

# Veriff: ask Veriff support to enable session deletion (off by default, and
# limited to 10 a day unless they raise it). Webhook: /api/verification/veriff-webhook.
VERIFF_API_KEY=""
VERIFF_SHARED_SECRET=""
VERIFF_BASE_URL=""

# Persona. Webhook: /api/verification/persona-webhook.
PERSONA_TEMPLATE_ID=""
PERSONA_ENVIRONMENT_ID=""
PERSONA_WEBHOOK_SECRET=""
# Used to delete each inquiry's ID images on Persona once we have the result.
PERSONA_API_KEY=""
ALLOW_VERIFICATION_STUB=""

# Photo storage (DigitalOcean Spaces is S3-compatible). Without S3_BUCKET,
# photos are stored on local disk (development only).
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_KEY=""
S3_SECRET=""

# "pre": photos hidden until a moderator approves (production default).
# "post": live after automated checks, reviewed afterwards (development default).
PHOTO_REVIEW_MODE=""
# Optional external image-safety scanner (e.g. a PhotoDNA / Hive proxy).
IMAGE_SCAN_URL=""
IMAGE_SCAN_TOKEN=""

# Web push notifications. Generate a pair with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"

# iPhone app notifications (Apple Push Notification service). Create a key under
# Apple Developer > Certificates, IDs & Profiles > Keys with "Apple Push
# Notifications service" ticked. Paste the .p8 file contents with \n for newlines.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="com.openheartdating.app"
# "false" while testing builds run straight from Xcode; leave unset for TestFlight/App Store.
APNS_PRODUCTION=""

# Voice/video calls work without these for most people. Some networks (strict
# office or mobile-carrier NAT) need a relay ("TURN") server; add one later,
# e.g. Cloudflare Calls TURN or Metered (both have free tiers), or self-host coturn.
# Comma-separated, e.g. "turn:turn.example.com:3478,turns:turn.example.com:5349"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Android app notifications (Firebase Cloud Messaging, free). Firebase console >
# Project settings > Service accounts > Generate new private key; paste the whole
# JSON on one line.
FCM_SERVICE_ACCOUNT_JSON=""

# Background jobs (date check-in alerts, event reminders, clean-up) run every
# minute inside the server in production. JOBS=off disables them; an external
# scheduler can then POST /api/cron with "Authorization: Bearer $CRON_SECRET".
JOBS=""
CRON_SECRET=""

# Urgent reports (threats, under-18, emergencies, non-consensual images) alert
# every moderator and admin within a minute by push, in-app and email — or
# SUPPORT_EMAIL if nobody is appointed yet. A summary of everything waiting is
# emailed daily at this hour (UTC; 13 = 9am US Eastern).
STAFF_DIGEST_HOUR_UTC="13"

# City-to-coordinates lookup (OpenStreetMap Nominatim). "off" to disable.
GEOCODING=""
