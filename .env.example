DATABASE_URL="postgresql://openheart:openheart@localhost:5432/openheart?schema=public"

# Auth.js reads AUTH_SECRET first, then NEXTAUTH_SECRET. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public address used in email links (defaults to AUTH_URL)
APP_URL="http://localhost:3000"

# Email (Resend, free tier). Without these, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="OpenHeart <hello@example.com>"

# Bot check on sign-up, login, and password reset (Cloudflare Turnstile, free). Optional.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Error alerts (Sentry, free tier). Optional; no member data is ever sent.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

CLOUDFLARE_API_TOKEN=""
DIGITALOCEAN_ACCESS_TOKEN=""

STRIPE_SECRET_KEY=""

# Public safety / child-safety contact (required by the App Store and Google Play)
SUPPORT_EMAIL=""

# Age verification (persona | veriff | stripe_identity | yoti)
VERIFICATION_PROVIDER="persona"
PERSONA_API_KEY=""
VERIFF_API_KEY=""

# Photo storage (DigitalOcean Spaces is S3-compatible)
S3_BUCKET=""
S3_REGION=""
S3_KEY=""
S3_SECRET=""
