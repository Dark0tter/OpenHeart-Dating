// OpenHeart Dating — Phase 1 schema
// Identity, attraction, and preferences are tag-driven (no binary gender search columns).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  LIMITED
  INCOGNITO
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  PENDING
  VERIFIED_ADULT
  NOT_VERIFIED
  REJECTED
}

enum PhotoVisibility {
  PUBLIC
  MATCH_ONLY
  PRIVATE
  ADULT
}

/// Where content may appear. The iOS and Android apps share one policy that
/// satisfies the stricter of Apple's and Google's store rules.
enum ContentTier {
  /// Shown everywhere, including the mobile apps by default.
  STANDARD
  /// Mobile apps show it only to verified adults who opted in on the website.
  ADULT_TEXT
  /// Never shown in the mobile apps.
  WEB_ONLY
}

enum KinkInterestLevel {
  FAVORITE
  INTERESTED
  CURIOUS
  NO
  HARD_LIMIT
}

enum ConsentScope {
  ADULT_ALBUM
  PROFILE_ACCESS
  PRIVATE_ALBUM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportReason {
  HARASSMENT
  SPAM
  CATFISHING
  UNDERAGE
  THREATS
  FRAUD
  NON_CONSENSUAL_CONTENT
  FINANCIAL_SOLICITATION
  EMERGENCY
  OTHER
}

enum ReportSource {
  USER
  AUTOMATED
}

/// Sexual interests are special-category data (GDPR Art. 9), so interest-based
/// sponsor placement is opt-in; GENERIC is the default.
enum AdPreference {
  GENERIC
  PROFILE_INTERESTS
  NONE
}

enum SponsorLabel {
  SPONSOR_SPOTLIGHT
  COMMUNITY_PARTNER
  COMMUNITY_EVENT
  EDUCATIONAL_RESOURCE
}

enum ReportPriority {
  NORMAL
  HIGH
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DENIED
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  emailVerified   DateTime?
  passwordHash    String
  /// Source of truth for the 18+ gate; age is always derived, never stored.
  dateOfBirth     DateTime
  accountStatus   AccountStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?
  /// Suspensions with an end date lift automatically; null means until reviewed.
  suspendedUntil  DateTime?
  adPreference    AdPreference  @default(GENERIC)
  /// Lets members appear in a room's online list. Incognito profiles never do.
  showOnline      Boolean       @default(true)
  /// Lets ADULT_TEXT content show in the mobile apps. Can only be changed on the website.
  appAdultContent Boolean       @default(false)
  termsAcceptedAt DateTime?
  /// "system" | "light" | "dark"; see src/lib/themes.ts.
  themeMode       String        @default("system")
  /// Pride flag theme id, or null for none.
  themeFlag       String?
  role            UserRole      @default(MEMBER)
  /// Bumped to sign the member out on every device (password change or reset).
  sessionVersion  Int           @default(0)
  /// Set when a moderator matches a pose selfie to the profile photos.
  photoVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastActiveAt    DateTime      @default(now())

  authTokens              AuthToken[]
  appeals                 Appeal[]
  supportTickets          SupportTicket[]
  selfieVerifications     SelfieVerification[]
  consentRequestsSent     ConsentRequest[]     @relation("ConsentRequestsSent")
  consentRequestsReceived ConsentRequest[]     @relation("ConsentRequestsReceived")
  profile                 Profile?
  verification            Verification?
  accounts                Account[]
  sessions                Session[]
  likesSent               Like[]               @relation("LikesSent")
  likesReceived           Like[]               @relation("LikesReceived")
  matchesAsA              Match[]              @relation("MatchUserA")
  matchesAsB              Match[]              @relation("MatchUserB")
  messagesSent            Message[]            @relation("MessagesSent")
  blocksInitiated         Block[]              @relation("BlocksInitiated")
  blocksReceived          Block[]              @relation("BlocksReceived")
  reportsFiled            Report[]             @relation("ReportsFiled")
  reportsAgainst          Report[]             @relation("ReportsAgainst")
  messageRequestsSent     MessageRequest[]     @relation("MessageRequestsSent")
  messageRequestsReceived MessageRequest[]     @relation("MessageRequestsReceived")
  consentGrantsGiven      ConsentGrant[]       @relation("ConsentGiven")
  consentGrantsReceived   ConsentGrant[]       @relation("ConsentReceived")
  roomMemberships         RoomMembership[]
  roomInvites             RoomInvite[]
  roomMessages            RoomMessage[]
  following               Follow[]             @relation("Following")
  followers               Follow[]             @relation("Followers")
  posts                   Post[]

  @@index([lastActiveAt])
  @@index([accountStatus])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time links sent by email. Only a SHA-256 hash is stored, so a database
/// leak can't be used to reset passwords.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Fixed-window counters shared by every server instance.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}

model Profile {
  id          String     @id @default(uuid())
  userId      String     @unique
  displayName String
  bio         String?    @db.Text
  pronouns    String?
  visibility  Visibility @default(PUBLIC)
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  radiusKm    Int        @default(50)
  isActive    Boolean    @default(false)
  shareToken  String     @unique @default(uuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos                 Photo[]
  identityTags           ProfileIdentityTag[]
  orientationTags        ProfileOrientationTag[]
  goalTags               ProfileGoalTag[]
  relationshipStyleTags  ProfileRelationshipStyleTag[]
  bodyTags               ProfileBodyTag[]
  ethnicityTags          ProfileEthnicityTag[]
  accessibilityTags      ProfileAccessibilityTag[]
  kinks                  ProfileKink[]
  seekingIdentityTags    SeekingIdentityTag[]
  seekingOrientationTags SeekingOrientationTag[]
  prompts                ProfilePrompt[]

  @@index([visibility, isActive])
  @@index([latitude, longitude])
}

/// Answers to guided questions; promptId refers to src/lib/constants/prompts.ts.
model ProfilePrompt {
  id        String  @id @default(uuid())
  profileId String
  promptId  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, promptId])
}

/// Images are re-encoded on upload (metadata and location stripped) and only
/// served through /api/photos/[id], which checks who may see each one.
model Photo {
  id              String          @id @default(uuid())
  profileId       String
  url             String
  storageKey      String?
  thumbKey        String?
  /// SHA-256 of the uploaded file, checked against BlockedImageHash.
  contentHash     String?
  width           Int?
  height          Int?
  visibility      PhotoVisibility @default(PUBLIC)
  status          ReviewStatus    @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  sortOrder       Int             @default(0)
  isPrimary       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, visibility])
  @@index([status, createdAt])
}

/// Files moderators removed for serious violations can never be uploaded again.
model BlockedImageHash {
  hash      String   @id
  reason    String
  createdAt DateTime @default(now())
}

/// A selfie with a requested pose, compared with profile photos by a moderator.
/// The selfie is deleted from storage as soon as it's reviewed.
model SelfieVerification {
  id         String       @id @default(uuid())
  userId     String
  storageKey String?
  gesture    String
  status     ReviewStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// "May I see your private photos?" Accepting creates a ConsentGrant.
model ConsentRequest {
  id          String               @id @default(uuid())
  requesterId String
  ownerId     String
  scope       ConsentScope
  status      MessageRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?
  requester   User                 @relation("ConsentRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  owner       User                 @relation("ConsentRequestsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId, scope])
  @@index([ownerId, status])
}

model IdentityTag {
  id       String               @id @default(uuid())
  slug     String               @unique
  label    String
  isCustom Boolean              @default(false)
  profiles ProfileIdentityTag[]
  seeking  SeekingIdentityTag[]
}

model OrientationTag {
  id       String                  @id @default(uuid())
  slug     String                  @unique
  label    String
  isCustom Boolean                 @default(false)
  profiles ProfileOrientationTag[]
  seeking  SeekingOrientationTag[]
}

model GoalTag {
  id       String           @id @default(uuid())
  slug     String           @unique
  label    String
  profiles ProfileGoalTag[]
  rooms    ChatRoom[]
}

model RelationshipStyleTag {
  id       String                        @id @default(uuid())
  slug     String                        @unique
  label    String
  profiles ProfileRelationshipStyleTag[]
}

model BodyTag {
  id       String           @id @default(uuid())
  slug     String           @unique
  label    String
  isCustom Boolean          @default(false)
  profiles ProfileBodyTag[]
}

model EthnicityTag {
  id       String                @id @default(uuid())
  slug     String                @unique
  label    String
  profiles ProfileEthnicityTag[]
}

model AccessibilityTag {
  id       String                    @id @default(uuid())
  slug     String                    @unique
  label    String
  profiles ProfileAccessibilityTag[]
}

model KinkCategory {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  tier        ContentTier @default(STANDARD)
  kinks       Kink[]
  rooms       ChatRoom[]
}

model Kink {
  id          String        @id @default(uuid())
  slug        String        @unique
  categoryId  String
  name        String
  description String?
  /// Effective tier: never lower than the category's.
  tier        ContentTier   @default(STANDARD)
  category    KinkCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  profiles    ProfileKink[]

  @@index([categoryId])
}

model ProfileIdentityTag {
  profileId String
  tagId     String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       IdentityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileOrientationTag {
  profileId String
  tagId     String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       OrientationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileGoalTag {
  profileId String
  tagId     String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       GoalTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileRelationshipStyleTag {
  profileId String
  tagId     String
  profile   Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       RelationshipStyleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileBodyTag {
  profileId String
  tagId     String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       BodyTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileEthnicityTag {
  profileId String
  tagId     String
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       EthnicityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileAccessibilityTag {
  profileId String
  tagId     String
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       AccessibilityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model ProfileKink {
  profileId String
  kinkId    String
  level     KinkInterestLevel
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kink      Kink              @relation(fields: [kinkId], references: [id], onDelete: Cascade)

  @@id([profileId, kinkId])
  @@index([kinkId, level])
}

/// Who this user wants to meet — tag-based, never hard-coded male/female columns.
model SeekingIdentityTag {
  profileId String
  tagId     String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       IdentityTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

model SeekingOrientationTag {
  profileId String
  tagId     String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tag       OrientationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
}

/// Never store ID documents or images — provider handles capture; we keep status + reference only.
model Verification {
  id                String             @id @default(uuid())
  userId            String             @unique
  status            VerificationStatus @default(NOT_VERIFIED)
  provider          String?
  providerReference String?
  verificationToken String?            @unique
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   User     @relation("LikesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Match {
  id          String    @id @default(uuid())
  userAId     String
  userBId     String
  createdAt   DateTime  @default(now())
  unmatchedAt DateTime?
  userA       User      @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User      @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

/// Messages belong to a match so a block or unmatch cuts off the whole conversation.
model Message {
  id         String    @id @default(uuid())
  matchId    String
  senderId   String
  body       String?   @db.Text
  imageUrl   String?
  voiceUrl   String?
  readAt     DateTime?
  /// Set when the message looks like a common scam; the recipient sees a warning.
  safetyFlag String?
  createdAt  DateTime  @default(now())
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender     User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model MessageRequest {
  id         String               @id @default(uuid())
  fromUserId String
  toUserId   String
  body       String               @db.Text
  status     MessageRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?
  fromUser   User                 @relation("MessageRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User                 @relation("MessageRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

/// AUTOMATED reports have no reporter; they come from content checks and wait for human review.
/// status: "open" | "resolved" | "dismissed".
model Report {
  id             String         @id @default(uuid())
  reporterId     String?
  reportedUserId String
  source         ReportSource   @default(USER)
  reason         ReportReason
  priority       ReportPriority @default(NORMAL)
  details        String?        @db.Text
  status         String         @default("open")
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
  assigneeId     String?
  resolvedById   String?
  resolution     String?        @db.Text
  /// Storage key of preserved evidence (e.g. a blocked upload).
  evidenceKey    String?
  /// Evidence and the reported account are kept even if the account is deleted.
  legalHold      Boolean        @default(false)
  /// When this was escalated for a child-safety (NCMEC CyberTipline) report.
  escalatedAt    DateTime?
  /// The CyberTipline report number, once filed.
  externalRef    String?
  reporter       User?          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser   User           @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([reportedUserId, reason, createdAt])
}

/// Append-only record of every staff action, for accountability and appeals.
model ModAction {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  reportId     String?
  action       String
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

model Appeal {
  id         String       @id @default(uuid())
  userId     String
  message    String       @db.Text
  status     ReviewStatus @default(PENDING)
  reviewerId String?
  reviewNote String?      @db.Text
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// status: "open" | "closed".
model SupportTicket {
  id        String    @id @default(uuid())
  userId    String?
  email     String
  category  String
  subject   String
  body      String    @db.Text
  status    String    @default("open")
  staffNote String?   @db.Text
  createdAt DateTime  @default(now())
  closedAt  DateTime?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum RoomKind {
  GENERAL
  KINK_CATEGORY
  GOAL
}

/// Interest-based group chat. Rosters are never exposed; members only see who posts.
model ChatRoom {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  description    String?
  kind           RoomKind
  kinkCategoryId String?
  goalTagId      String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  kinkCategory   KinkCategory?    @relation(fields: [kinkCategoryId], references: [id], onDelete: SetNull)
  goalTag        GoalTag?         @relation(fields: [goalTagId], references: [id], onDelete: SetNull)
  members        RoomMembership[]
  invites        RoomInvite[]
  messages       RoomMessage[]
}

model RoomMembership {
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  /// Updated while the member has the room open; drives the online list.
  lastSeenAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@index([roomId, lastSeenAt])
}

enum RoomInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Sent automatically when a member's profile interests match a room. A declined
/// invite is never re-sent.
model RoomInvite {
  id          String           @id @default(uuid())
  roomId      String
  userId      String
  status      RoomInviteStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  room        ChatRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, status])
}

model RoomMessage {
  id        String    @id @default(uuid())
  roomId    String
  senderId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Post {
  id        String    @id @default(uuid())
  authorId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
}

/// Targeting uses only kink and relationship-goal slugs the member chose to list.
/// There are deliberately no impression, click, or viewer columns.
model SponsorPlacement {
  id              String       @id @default(uuid())
  label           SponsorLabel @default(SPONSOR_SPOTLIGHT)
  sponsorName     String
  title           String
  body            String?
  linkUrl         String
  targetKinkSlugs String[]
  targetGoalSlugs String[]
  /// Set from the creative itself; explicit creatives must not reach the apps.
  contentTier     ContentTier  @default(WEB_ONLY)
  isActive        Boolean      @default(true)
  startsAt        DateTime     @default(now())
  endsAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([isActive, startsAt])
}

/// Granter lets viewer see gated content: an adult album, or an incognito profile.
model ConsentGrant {
  id        String       @id @default(uuid())
  granterId String
  viewerId  String
  scope     ConsentScope
  createdAt DateTime     @default(now())
  revokedAt DateTime?
  granter   User         @relation("ConsentGiven", fields: [granterId], references: [id], onDelete: Cascade)
  viewer    User         @relation("ConsentReceived", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([granterId, viewerId, scope])
  @@index([viewerId, scope])
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  /// "free" | "supporter". Supporter perks are extras, never core dating features.
  plan             String    @default("free")
  stripeCustomerId String?
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
